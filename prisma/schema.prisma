  streamId                   String?   @map("stream_id") @db.Uuid
  /// Members who lead: their login (leader roles are held by members).
  userId                     String?   @map("user_id") @db.Uuid
  possibleDuplicateOfId      String?   @map("possible_duplicate_of_id") @db.Uuid
  /// Converts: the Sheep Seeker (a member) who brought or registered them.
  seekerPersonId             String?   @map("seeker_person_id") @db.Uuid
  /// The existing connection was matched by the AI from the convert's note.
  connectionByAi             Boolean   @default(false) @map("connection_by_ai")
  status                     String    @db.VarChar(20)
  source                     String    @default("staff") @db.VarChar(10)
  notes                      String?
  createdBy                  String?   @map("created_by") @db.Uuid
  createdAt                  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz(6)

  zone                CcgZone?                 @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ccf                 CcgFamily?               @relation(fields: [ccfId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stream              CcgStream?               @relation(fields: [streamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  existingConnection  CcgPerson?               @relation("CcgConnection", fields: [existingConnectionMemberId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  connectedConverts   CcgPerson[]              @relation("CcgConnection")
  possibleDuplicateOf CcgPerson?               @relation("CcgDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  possibleDuplicates  CcgPerson[]              @relation("CcgDuplicate")
  answers             CcgAnswer[]
  matchRuns           CcgMatchRun[]
  placements          CcgPlacement[]
  formLinks           CcgFormLink[]
  attendance          CcgAttendance[]
  prayedFor           CcgGroupActivityPerson[]
  user                User?                    @relation("CcgPersonUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transfers           CcgTransfer[]
  seeker              CcgPerson?               @relation("CcgSeeker", fields: [seekerPersonId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  seekerOf            CcgPerson[]              @relation("CcgSeeker")
  seekerLinks         CcgFormLink[]            @relation("CcgLinkSeeker")
  invites             CcgInvite[]

  @@index([kind, status], map: "idx_ccg_people_kind")
  @@index([ccfId], map: "idx_ccg_people_ccf")
  @@index([phone], map: "idx_ccg_people_phone")
  @@map("ccg_people")
}

