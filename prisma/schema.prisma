  reason        String
  overCapacity  Boolean   @default(false) @map("over_capacity")
  transferredBy String?   @map("transferred_by") @db.Uuid
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  person    CcgPerson     @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  placement CcgPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fromCcf   CcgFamily?    @relation("CcgTransferFrom", fields: [fromCcfId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  toCcf     CcgFamily     @relation("CcgTransferTo", fields: [toCcfId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([personId, createdAt(sort: Desc)], map: "idx_ccg_transfers_person")
  @@map("ccg_transfers")
}

/// One-time link emailed to a member given a role, to set their own password.
model CcgInvite {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  personId  String?   @map("person_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// invite (first password, after being given a role) | reset (forgot password)
  purpose   String    @default("invite") @db.VarChar(10)
  sentTo    String    @map("sent_to") @db.VarChar(254)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User       @relation("CcgInviteUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  person CcgPerson? @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_ccg_invites_user")
  @@map("ccg_invites")
}
