# Neon Database Connection
NEON_DATABASE_URL=your_neon_database_connection_string_here

# JWT Secret (Change this in production! Must be at least 32 characters of random data.)
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters

# Sysadmin account password for create-sysadmin.js and verify-sysadmin.js scripts.
# Must be a strong, randomly-generated password. Never commit the real value.
SYSADMIN_PASSWORD=

# --- Optional ---

# User id automated jobs act as. If unset (or invalid), a non-loginable
# "system" user is found or created automatically.
# SYSTEM_USER_ID=

# In-app raw database editor (superadmin UI). Disabled unless exactly "true".
# ENABLE_DB_EDITOR=false

# Comma-separated usernames additionally allowed to use the DB editor.
# Empty = any superadmin (when the editor is enabled).
# DB_EDITOR_USERS=
